{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "xhigh",
  "defaultProjectTrust": "never",
  "showLastPrompt": true,
  "powerline": {
    "preset": "default",
    "placement": "below",
    "welcome": false,
    "separator": "powerline-thin",
    "layout": {
      "left": ["model", "thinking", "path", "git", "queue"],
      "right": ["context_pct", "cache_read"],
      "secondary": ["extension_statuses"]
    },
    "model": {
      "display": "qualified",
      "showThinkingLevel": false
    },
    "path": {
      "mode": "abbreviated",
      "maxLength": 30
    },
    "git": {
      "showBranch": true,
      "showStaged": true,
      "showUnstaged": true,
      "showUntracked": true,
      "polling": "branch",
      "hostIcon": true
    },
    "context": { "format": "percent" },
    "cache_read": { "format": "both" }
  },
  "defaultTools": ["+codemode"],
  "codemode": { "mode": "on" }
}
