{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "low",
  "defaultProjectTrust": "never",
  "subagents": {
    "defaultModel": "openai-codex/gpt-6-luna",
    "defaultThinking": "high",
    "maxThinking": "max",
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "inherit",
        "openai-codex/gpt-6-astra",
        "openai-codex/gpt-6-luna",
        "commandcode-goat/xiaomi/mimo-v2.6-pro",
        "commandcode-goat/z-ai/glm-5.3-flash",
        "commandcode-goat/Qwen/Qwen3.8-Flash"
      ],
      "agents": {
        "worker": {
          "allow": [
            "openai-codex/gpt-6-luna",
            "openai-codex/gpt-6-astra",
            "commandcode-goat/z-ai/glm-5.3-flash",
            "commandcode-goat/Qwen/Qwen3.8-Flash"
          ]
        },
        "poteto-agent": {
          "allow": [
            "openai-codex/gpt-6-luna",
            "openai-codex/gpt-6-astra",
            "commandcode-goat/z-ai/glm-5.3-flash",
            "commandcode-goat/Qwen/Qwen3.8-Flash"
          ]
        },
        "how-analyst": {
          "allow": [
            "openai-codex/gpt-6-luna",
            "openai-codex/gpt-6-astra"
          ]
        }
      }
    },
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "low",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "multi_grep",
          "lens_diagnostics",
          "module_report",
          "project_report",
          "read_symbol",
          "read_enclosing",
          "symbol_search",
          "pi_lens_activate_tools",
          "ast_grep_search",
          "contact_supervisor"
        ]
      },
      "researcher": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "high"
      },
      "how-analyst": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "high",
        "tools": ["read", "grep", "find", "ls"]
      },
      "worker": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "max",
        "tools": "inherit"
      },
      "reviewer": {
        "model": "commandcode-goat/z-ai/glm-5.3-flash",
        "thinking": "high",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "multi_grep",
          "watchdog_diff",
          "lens_diagnostics",
          "module_report",
          "project_report",
          "read_symbol",
          "read_enclosing",
          "symbol_search",
          "pi_lens_activate_tools",
          "ast_grep_search",
          "contact_supervisor"
        ]
      },
      "oracle": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "xhigh",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "multi_grep",
          "lens_diagnostics",
          "module_report",
          "project_report",
          "read_symbol",
          "read_enclosing",
          "symbol_search",
          "pi_lens_activate_tools",
          "ast_grep_search"
        ]
      },
      "poteto-agent": {
        "model": "openai-codex/gpt-6-luna",
        "tools": "inherit",
        "thinking": "max",
        "allowNestedSubagents": true
      },
      "comment-sicko": {
        "model": "commandcode-goat/Qwen/Qwen3.8-Flash",
        "thinking": "xhigh",
        "tools": ["read", "grep", "find", "ls"]
      },
      "delegate": {
        "disabled": true
      },
      "gpt-pro": {
        "disabled": true
      }
    }
  },
  "showLastPrompt": true,
  "powerline": {
    "preset": "default",
    "placement": "below",
    "welcome": false,
    "separator": "powerline-thin",
    "layout": {
      "left": [
        "model",
        "thinking",
        "path",
        "git",
        "queue",
        "subagents"
      ],
      "right": [
        "context_pct",
        "cache_read"
      ],
      "secondary": [
        "extension_statuses"
      ]
    },
    "model": {
      "display": "qualified",
      "showThinkingLevel": false
    },
    "path": {
      "mode": "abbreviated",
      "maxLength": 30
    },
    "git": {
      "showBranch": true,
      "showStaged": true,
      "showUnstaged": true,
      "showUntracked": true,
      "polling": "branch",
      "hostIcon": true
    },
    "context": {
      "format": "percent"
    },
    "cache_read": {
      "format": "both"
    }
  }
}
