{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "low",
  "defaultProjectTrust": "never",
  "subagents": {
    "defaultModel": "commandcode-goat/z-ai/glm-5.3-flash",
    "defaultThinking": "high",
    "maxThinking": "max",
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "inherit",
        "openai-codex/gpt-6-astra",
        "commandcode-goat/deepseek/deepseek-v4.1-flash-beta",
        "commandcode-goat/z-ai/glm-5.3-flash",
        "commandcode-goat/Qwen/Qwen3.8-Flash"
      ]
    },
    "agentOverrides": {
      "scout": {
        "model": "commandcode-goat/deepseek/deepseek-v4.1-flash-beta",
        "thinking": "high",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "lens_diagnostics",
          "lsp_diagnostics",
          "module_report",
          "read_symbol",
          "read_enclosing",
          "symbol_search"
        ]
      },
      "researcher": {
        "model": "commandcode-goat/deepseek/deepseek-v4.1-flash-beta",
        "thinking": "high"
      },
      "worker": {
        "model": "commandcode-goat/z-ai/glm-5.3-flash",
        "thinking": "high",
        "tools": "inherit"
      },
      "reviewer": {
        "model": "commandcode-goat/Qwen/Qwen3.8-Flash",
        "thinking": "medium",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "lens_diagnostics",
          "lsp_diagnostics",
          "module_report",
          "read_symbol",
          "read_enclosing",
          "symbol_search"
        ]
      },
      "oracle": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "high",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "lens_diagnostics",
          "lsp_diagnostics",
          "module_report",
          "read_symbol",
          "read_enclosing",
          "symbol_search"
        ]
      },
      "poteto-agent": {
        "model": "commandcode-goat/z-ai/glm-5.3-flash",
        "tools": "inherit",
        "thinking": "high",
        "allowNestedSubagents": true
      },
      "comment-sicko": {
        "model": "commandcode-goat/Qwen/Qwen3.8-Flash",
        "thinking": "medium"
      },
      "delegate": {
        "disabled": true
      },
      "gpt-pro": {
        "disabled": true
      }
    }
  },
  "showLastPrompt": true,
  "powerline": {
    "preset": "default",
    "placement": "below",
    "welcome": false,
    "separator": "powerline-thin",
    "layout": {
      "left": [
        "model",
        "thinking",
        "path",
        "git",
        "queue",
        "subagents"
      ],
      "right": [
        "context_pct",
        "cache_read"
      ],
      "secondary": [
        "extension_statuses"
      ]
    },
    "model": {
      "display": "qualified",
      "showThinkingLevel": false
    },
    "path": {
      "mode": "abbreviated",
      "maxLength": 30
    },
    "git": {
      "showBranch": true,
      "showStaged": true,
      "showUnstaged": true,
      "showUntracked": true,
      "polling": "branch",
      "hostIcon": true
    },
    "context": {
      "format": "percent"
    },
    "cache_read": {
      "format": "both"
    }
  }
}
