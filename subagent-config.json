{
  "toolDescriptionMode": "compact",
  "artifactDir": "session",
  "defaultSubagentContext": "fresh",
  "maxSubagentDepth": 2,
  "maxSubagentSpawnsPerRun": 32,
  "globalConcurrencyLimit": 8,
  "parallel": {
    "maxTasks": 8,
    "concurrency": 4
  },
  "modelExclusions": {
    "defaultTtlMs": 300000
  },
  "missions": {
    "enabled": false
  },
  "scheduledRuns": {
    "enabled": false
  },
  "authorityPolicy": {
    "discardWorktree": "auto",
    "destructiveCleanup": "auto",
    "scheduleCreate": "forbid"
  }
}
