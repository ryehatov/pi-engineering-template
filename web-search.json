{
  "workflow": "none",
  "searchRouting": {
    "providers": [
      "openai",
      "exa"
    ],
    "useCurrentModel": true,
    "fallbackOn": [
      "unsupported",
      "transient",
      "quota",
      "network",
      "invalid-response"
    ]
  },
  "fetchContent": {
    "domainPolicy": {
      "deny": [
        "127.0.0.1"
      ]
    }
  }
}
