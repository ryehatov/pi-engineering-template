{
  "workflow": "none",
  "searchRouting": {
    "providers": [
      "openai",
      "searxng"
    ],
    "useCurrentModel": true,
    "fallbackOn": [
      "unsupported"
    ]
  },
  "searxngBaseUrl": "http://127.0.0.1:8080",
  "ssrf": {
    "allowRanges": [
      "127.0.0.1/32"
    ]
  },
  "fetchContent": {
    "domainPolicy": {
      "deny": [
        "127.0.0.1"
      ]
    }
  }
}
